{
  "nodeModulesDir": "auto",
  "deploy": {
    "org": "metapage",
    "app": "npm",
    // Spelled out rather than left to auto-detection: this app predates the
    // Fresh 2 migration, and whatever build settings it still carries in the
    // Deploy console are for the old layout. Fields set here take precedence
    // over the console.
    "install": "deno install",
    "build": "deno task build",
    "runtime": {
      "mode": "dynamic",
      "entrypoint": "_fresh/server.js"
    }
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "preview": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "imports": {
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@metapages/metapage": "npm:@metapages/metapage@^1.10.11",
    "@std/http/file-server": "jsr:@std/http@^1/file-server",
    "@std/path": "jsr:@std/path@^1",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "compare-versions": "npm:compare-versions@^6.1.1"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "fmt": {
    "exclude": ["static"]
  },
  "lint": {
    "exclude": ["static"],
    "rules": {
      "tags": ["fresh", "recommended"]
    }
  },
  // static/ is kept out of fmt/lint only, not out of the top-level exclude:
  // that one also narrows what `deno deploy` uploads, and static/ must ship —
  // /m, /mf and the test-script routes read their sources from it.
  "exclude": [
    "**/_fresh/*",
    ".certs",
    "node_modules",
    "test"
  ]
}
